# Set these in the process environment. This file is not loaded automatically.
# Generate a unique random secret with at least 50 characters. Never use this placeholder.
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://tseh:replace-password@127.0.0.1:55432/tseh
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=1
# 1 only behind a verified proxy that overwrites X-Forwarded-Proto and X-Real-IP.
DJANGO_TRUST_PROXY=0
DJANGO_LOGIN_MAX_ATTEMPTS=10
DJANGO_LOGIN_WINDOW_SECONDS=300
TZ=Asia/Qyzylorda
PORT=8000
